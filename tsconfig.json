{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "composite": true,
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "bun",
            "node"
        ]
    },
    "include": [
        "**/*.ts",
        "package.json"
    ]
}